#!/usr/bin/env -S deno run --allow-env --allow-net=api.anthropic.com,platform.claude.com --allow-read --allow-write --allow-run=security

// claude-quota — prints the remaining quota of every Claude account (default +
// ~/.claude-profiles/*), one line per account. `c` (the account picker in
// zshrc) uses these lines as fzf rows.
//
//   $ claude-quota
//   default 	kohei@conocer.co 	5h ⣿⣿⣀      12%  7d ⣿⣄       7%  fable ⣿⣶      10%
//
// The output matches the dashboard.mi.nu quota cards (errands
// jobs/agent-usage/quota.ts) and ~/.claude/statusline.py: same braille bars,
// same green-to-red gradient, same labels (session→5h / weekly_all→7d /
// weekly_scoped→lowercased model name).
//
// Tokens are read from the Keychain. The service name follows claude's own
// convention: "Claude Code-credentials" plus the first 8 hex chars of the
// sha256 of CLAUDE_CONFIG_DIR as a suffix. Access tokens expire after a few
// hours; for an account claude itself hasn't run recently the token is stale,
// so near/past expiry we refresh it with the refresh token and write the
// result back to the Keychain (same flow as errands jobs/agent-usage/quota.ts,
// including the re-read guard against racing claude's own refresh). Fetches
// run for all accounts in parallel with a 3s timeout and a 5-minute cache in
// ~/.cache/claude-quota (so reopening the picker doesn't block). --fresh
// bypasses the cache.

import { createHash } from "node:crypto";

const HOME = Deno.env.get("HOME") ?? "";
const PROFILES_DIR = `${HOME}/.claude-profiles`;
const CACHE_DIR = `${HOME}/.cache/claude-quota`;
const CACHE_TTL_MS = 5 * 60_000;
const TIMEOUT_MS = 3_000;
const USAGE_URL = "https://api.anthropic.com/api/oauth/usage";
const TOKEN_URL = "https://platform.claude.com/v1/oauth/token";
const CLIENT_ID = "9d1c250a-e61b-44d9-88ed-5944d1962f5e"; // Claude Code's own
const TOKEN_REFRESH_MARGIN_MS = 5 * 60_000;
const BAR_WIDTH = 8;

const R = "\x1b[0m";
const DIM = "\x1b[2m";
const BRAILLE = " ⣀⣄⣤⣦⣶⣷⣿";

interface Account {
  name: string;
  configDir: string; // "" = default (~/.claude)
  claudeJson: string;
}

interface Limit {
  label: string;
  percent: number;
}

function accounts(): Account[] {
  const out: Account[] = [{
    name: "default",
    configDir: "",
    claudeJson: `${HOME}/.claude.json`,
  }];
  try {
    const names = [...Deno.readDirSync(PROFILES_DIR)]
      .filter((e) => e.isDirectory)
      .map((e) => e.name)
      .sort();
    for (const name of names) {
      out.push({
        name,
        configDir: `${PROFILES_DIR}/${name}`,
        claudeJson: `${PROFILES_DIR}/${name}/.claude.json`,
      });
    }
  } catch {
    // no profiles dir → default account only
  }
  return out;
}

// Same service-name convention as claude itself (oG() in bin/claude.exe)
function keychainService(configDir: string): string {
  if (!configDir) return "Claude Code-credentials";
  const hash = createHash("sha256")
    .update(configDir.normalize("NFC"))
    .digest("hex")
    .slice(0, 8);
  return `Claude Code-credentials-${hash}`;
}

function email(a: Account): string {
  try {
    const doc = JSON.parse(Deno.readTextFileSync(a.claudeJson));
    return doc?.oauthAccount?.emailAddress ?? "not logged in";
  } catch {
    return "not logged in";
  }
}

async function keychainRead(
  service: string,
): Promise<Record<string, unknown> | null> {
  const { code, stdout } = await new Deno.Command("security", {
    args: ["find-generic-password", "-s", service, "-w"],
    stdout: "piped",
    stderr: "null",
  }).output();
  if (code !== 0) return null;
  try {
    return JSON.parse(new TextDecoder().decode(stdout));
  } catch {
    return null;
  }
}

async function keychainWrite(
  service: string,
  doc: Record<string, unknown>,
): Promise<void> {
  const account = Deno.env.get("USER") ?? "";
  const { code } = await new Deno.Command("security", {
    args: [
      "add-generic-password",
      "-U",
      "-s",
      service,
      "-a",
      account,
      "-w",
      JSON.stringify(doc),
    ],
    stdout: "null",
    stderr: "null",
  }).output();
  if (code !== 0) throw new Error(`security add-generic-password -> ${code}`);
}

// Returns a usable access token, refreshing it first if it is expired or
// about to expire. Mirrors freshClaudeTokenFile() in errands quota.ts:
// re-read the Keychain before writing and, if the refresh token changed,
// claude refreshed concurrently and its result wins.
async function keychainToken(service: string): Promise<string | null> {
  const doc = await keychainRead(service);
  const oauth = doc?.claudeAiOauth as Record<string, unknown> | undefined;
  const accessToken = oauth?.accessToken;
  if (!doc || typeof accessToken !== "string") return null;
  const expiresAt = Number(oauth?.expiresAt);
  if (
    !Number.isFinite(expiresAt) ||
    expiresAt > Date.now() + TOKEN_REFRESH_MARGIN_MS
  ) {
    return accessToken;
  }
  const refreshToken = oauth?.refreshToken;
  if (typeof refreshToken !== "string") return null;

  let refreshed: Record<string, unknown>;
  try {
    const res = await fetch(TOKEN_URL, {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({
        grant_type: "refresh_token",
        refresh_token: refreshToken,
        client_id: CLIENT_ID,
      }),
      signal: AbortSignal.timeout(TIMEOUT_MS),
    });
    if (!res.ok) {
      await res.body?.cancel();
      return null;
    }
    refreshed = await res.json();
  } catch {
    return null;
  }
  const expiresIn = Number(refreshed.expires_in);
  if (typeof refreshed.access_token !== "string" || !Number.isFinite(expiresIn)) {
    return null;
  }

  const latest = await keychainRead(service);
  const latestOauth = latest?.claudeAiOauth as
    | Record<string, unknown>
    | undefined;
  if (!latest || latestOauth?.refreshToken !== refreshToken) {
    return typeof latestOauth?.accessToken === "string"
      ? latestOauth.accessToken
      : null;
  }
  const refreshExpiresIn = Number(refreshed.refresh_token_expires_in);
  latest.claudeAiOauth = {
    ...latestOauth,
    accessToken: refreshed.access_token,
    refreshToken: typeof refreshed.refresh_token === "string"
      ? refreshed.refresh_token
      : refreshToken,
    expiresAt: Date.now() + expiresIn * 1000,
    ...(Number.isFinite(refreshExpiresIn)
      ? { refreshTokenExpiresAt: Date.now() + refreshExpiresIn * 1000 }
      : {}),
  };
  try {
    await keychainWrite(service, latest);
  } catch {
    // Worst case the next run refreshes again with the (rotated) old token
    // already invalid — claude will re-login. Don't fail the fetch over it.
  }
  return refreshed.access_token;
}

// Same mapping as toLimit() in errands jobs/agent-usage/quota.ts
function toLimits(usage: Record<string, unknown>): Limit[] {
  const out: Limit[] = [];
  for (const raw of (usage.limits ?? []) as Record<string, unknown>[]) {
    const kind = String(raw.kind ?? "");
    const percent = Number(raw.percent);
    if (!kind || !Number.isFinite(percent)) continue;
    const scope = raw.scope as { model?: { display_name?: string } } | null;
    const model = scope?.model?.display_name;
    const label = kind === "session"
      ? "5h"
      : kind === "weekly_all"
      ? "7d"
      : model
      ? model.toLowerCase()
      : kind;
    out.push({ label, percent: Math.round(percent) });
  }
  return out;
}

async function fetchLimits(a: Account): Promise<Limit[] | null> {
  const cachePath = `${CACHE_DIR}/${a.name}.json`;
  if (!Deno.args.includes("--fresh")) {
    try {
      const st = Deno.statSync(cachePath);
      if (st.mtime && Date.now() - st.mtime.getTime() < CACHE_TTL_MS) {
        return JSON.parse(Deno.readTextFileSync(cachePath));
      }
    } catch {
      // cache miss
    }
  }
  const token = await keychainToken(keychainService(a.configDir));
  if (!token) return null;
  let usage: Record<string, unknown>;
  try {
    const res = await fetch(USAGE_URL, {
      headers: {
        "Authorization": `Bearer ${token}`,
        "anthropic-beta": "oauth-2025-04-20",
      },
      signal: AbortSignal.timeout(TIMEOUT_MS),
    });
    if (!res.ok) {
      await res.body?.cancel();
      return null;
    }
    usage = await res.json();
  } catch {
    return null;
  }
  const limits = toLimits(usage);
  try {
    Deno.mkdirSync(CACHE_DIR, { recursive: true });
    Deno.writeTextFileSync(cachePath, JSON.stringify(limits));
  } catch {
    // caching is best effort
  }
  return limits;
}

// Same rendering as statusline.py / quota.ts
function brailleBar(pct: number): string {
  const level = Math.min(Math.max(pct, 0), 100) / 100;
  let bar = "";
  for (let i = 0; i < BAR_WIDTH; i++) {
    const start = i / BAR_WIDTH;
    const end = (i + 1) / BAR_WIDTH;
    if (level >= end) bar += BRAILLE[7];
    else if (level <= start) bar += BRAILLE[0];
    else {
      bar += BRAILLE[
        Math.min(Math.floor(((level - start) / (end - start)) * 7), 7)
      ];
    }
  }
  return bar;
}

function gradient(pct: number): string {
  const p = Math.min(Math.max(pct, 0), 100);
  const [r, g, b] = p < 50
    ? [Math.round(p * 5.1), 200, 80]
    : [255, Math.max(Math.round(200 - (p - 50) * 4), 0), 60];
  return `\x1b[38;2;${r};${g};${b}m`;
}

function fmtLimits(limits: Limit[] | null): string {
  if (limits === null) return `${DIM}quota n/a${R}`;
  if (limits.length === 0) return `${DIM}no limits${R}`;
  return limits.map((l) =>
    `${DIM}${l.label}${R} ${gradient(l.percent)}${brailleBar(l.percent)}${R} ${
      String(l.percent).padStart(3)
    }%`
  ).join("  ");
}

if (import.meta.main) {
  const list = accounts();
  const limits = await Promise.all(list.map(fetchLimits));
  const nameW = Math.max(...list.map((a) => a.name.length));
  const emails = list.map(email);
  const emailW = Math.max(...emails.map((e) => e.length));
  for (let i = 0; i < list.length; i++) {
    console.log(
      `${list[i].name.padEnd(nameW)}\t${emails[i].padEnd(emailW)}\t${
        fmtLimits(limits[i])
      }`,
    );
  }
}
